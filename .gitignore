# ==========================================
# VacayVault - Git Ignore Configuration
# ==========================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Production and Build Outputs
dist/
*/dist/
build/
*/build/
out/
.next/
*.tsbuildinfo

# Environment & Secret Files (Never commit credentials!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
!*/.env.example

# Logs and Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor and IDE Files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# Temporary and Cache Directories
.cache/
.parcel-cache/
.eslintcache
tmp/
temp/
*.tmp
.tempmediaStorage/
scratch/

# Database dumps / sqlite local test files
*.sqlite
*.sqlite3
*.db
*.dump
